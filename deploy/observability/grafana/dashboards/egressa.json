    {
      "type": "state-timeline",
      "id": 17,
      "title": "Flap guard",
      "description": "Confirming: a better path is waiting out the confirmation window, minimum residence or cooldown.",
      "datasource": {
        "type": "prometheus",
        "uid": "egressa-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "egressa-prometheus"
          },
          "expr": "sum(rate(egressa_client_decisions_total{node=~\"$client\",outcome=\"confirming\"}[10s])) > bool 0",
          "legendFormat": "flap guard",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle",
                  "color": "transparent",
                  "index": 0
                },
                "1": {
                  "text": "confirming",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0

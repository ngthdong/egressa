{
  "uid": "egressa",
  "title": "egressa",
  "tags": [
    "egressa"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Migrations",
        "datasource": {
          "type": "prometheus",
          "uid": "egressa-prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "step": "10s",
        "expr": "count_values by (node) (\"epoch\", egressa_client_session_epoch{node=~\"$client\"} and on(node) changes(egressa_client_session_epoch{node=~\"$client\"}[10s]) > 0)",
        "titleFormat": "Migration",
        "textFormat": "{{node}}: now at epoch {{epoch}}",
        "tagKeys": "node"
      },
      {
        "name": "Migration duration",
        "datasource": {
          "type": "prometheus",
          "uid": "egressa-prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "step": "10s",
        "expr": "count_values by (node, cause) (\"duration_ms\", round(1000 * sum by (node, cause) (increase(egressa_client_migration_duration_seconds_sum{node=~\"$client\"}[10s])) / sum by (node, cause) (increase(egressa_client_migration_duration_seconds_count{node=~\"$client\"}[10s]))) > 0)",
        "titleFormat": "Migration done",
        "textFormat": "{{node}}: {{cause}} migration took {{duration_ms}} ms",
        "tagKeys": "cause"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "client",
        "label": "Client",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "egressa-prometheus"
        },
        "query": {
          "query": "label_values(egressa_client_session_epoch, node)",
          "refId": "client"
        },
        "definition": "label_values(egressa_client_session_epoch, node)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Paths: client → access gateway",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "RTT per path (p50)",
      "description": "Median RTT from the client to each access gateway, through the tunnel.",
      "datasource": {
        "type": "prometheus",
        "uid": "egressa-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "egressa-prometheus"
          },
          "expr": "egressa_client_segment_rtt_seconds{node=~\"$client\",percentile=\"50\"}",
          "legendFormat": "{{gateway}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Jitter per path (p95 − p50)",
      "description": "Spread between the 95th and 50th percentile RTT: the variation the decision penalises.",
      "datasource": {
        "type": "prometheus",
        "uid": "egressa-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "egressa-prometheus"
          },
          "expr": "egressa_client_segment_rtt_seconds{node=~\"$client\",percentile=\"95\"} - ignoring(percentile) egressa_client_segment_rtt_seconds{node=~\"$client\",percentile=\"50\"}",
          "legendFormat": "{{gateway}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Loss per path",
      "description": "Probe loss to each access gateway.",

        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Cost per path",
      "description": "Cost of each usable path (access → egress): median RTT plus tail and loss penalties.",
      "datasource": {
        "type": "prometheus",
        "uid": "egressa-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "egressa-prometheus"
          },
          "expr": "egressa_client_path_cost_seconds{node=~\"$client\"}",
          "legendFormat": "{{access}} → {{egress}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "LCB(Δ) against the margin",
      "description": "Lower confidence bound of Cost(current) − Cost(path). A path whose LCB(Δ) stays above the threshold (migration cost + safety margin) is better enough to move to.",
      "datasource": {
        "type": "prometheus",
        "uid": "egressa-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "egressa-prometheus"
          },
          "expr": "egressa_client_path_delta_lower_seconds{node=~\"$client\"}",
          "legendFormat": "LCB(Δ) {{access}} → {{egress}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "egressa-prometheus"
          },
          "expr": "egressa_client_decision_threshold_seconds{node=~\"$client\"}",
          "legendFormat": "threshold",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "threshold"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
